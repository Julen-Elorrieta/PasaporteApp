<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Título de la app -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/app_name"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/fabCircular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fabCircular" />

    <!-- Botones superiores -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCircular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_home"
        app:fabSize="mini"
        app:layout_constraintEnd_toStartOf="@+id/fabCircular2"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCircular2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_bookmark"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="@+id/fabCircular"
        app:layout_constraintEnd_toStartOf="@+id/fabAyuda"
        app:layout_constraintTop_toTopOf="@+id/fabCircular" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAyuda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="@+id/fabCircular"
        app:layout_constraintEnd_toStartOf="@+id/fabAyuda2"
        app:layout_constraintTop_toTopOf="@+id/fabCircular"
        app:srcCompat="@android:drawable/ic_menu_help"
        app:tint="@android:color/white" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAyuda2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="@+id/fabCircular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fabCircular"
        app:srcCompat="@drawable/ic_settings"
        app:tint="@android:color/white" />

    <!-- Buscador -->
    <EditText
        android:id="@+id/etBuscador"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:hint="Buscar país..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="#202124"
        android:textColorHint="#5F6368"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fabCircular" />

    <!-- Contenedor deslizable para las píldoras de región -->
    <HorizontalScrollView
        android:id="@+id/hsvRegiones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etBuscador">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPildora"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="20dp"
                android:text="Todos"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="#1A73E8"
                app:cornerRadius="50dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPildora2"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="20dp"
                android:text="Europe"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="#1A73E8"
                app:cornerRadius="50dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPildora3"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="20dp"
                android:text="Asia"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="#1A73E8"
                app:cornerRadius="50dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPildora4"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="20dp"
                android:text="Africa"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="#1A73E8"
                app:cornerRadius="50dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPildora5"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="20dp"
                android:text="Americas"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="#1A73E8"
                app:cornerRadius="50dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Lista en cuadrícula de países -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCountries"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hsvRegiones"
        tools:listitem="@layout/item_country" />

    <!-- ProgressBar centrado mientras carga -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/rvCountries"
        app:layout_constraintEnd_toEndOf="@+id/rvCountries"
        app:layout_constraintStart_toStartOf="@+id/rvCountries"
        app:layout_constraintTop_toTopOf="@+id/rvCountries" />

</androidx.constraintlayout.widget.ConstraintLayout>
